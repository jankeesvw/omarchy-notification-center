#!/usr/bin/env bash
#
# The store behind the notification center.
#
# Omarchy's notification service writes closed notifications to history.json
# on newer builds, keeping a day and at most 100 rows. Older builds write one
# JSON file per popup and move it into history/, keeping only ten files.
#
# This copies notifications into a longer-lived archive, with their icons
# beside them so an entry still has a face in a month. Aggregate history is
# read on every rewrite and never changed here; live.json and quiet.json belong
# to the service and are left alone.
#
# Every subcommand prints JSON, one object or one array, including failures, so
# nothing that goes wrong reaches the panel as a parse error.

set -uo pipefail

# Everything this writes is a record of what you were sent, so nothing it
# creates is readable by anyone else on the machine. Set once here rather than
# per file, because the one that gets forgotten is the one that matters.
umask 077

state_home=${XDG_STATE_HOME:-$HOME/.local/state}

# The service keeps history.json, live.json and quiet.json in src_dir on newer
# builds. Only history.json is ingested. Older builds keep popups there and
# move them into history/ when they close.
# Overridable so the whole thing can be pointed at a scratch directory and
# driven by hand, which is the only way to exercise the watcher without waiting
# for real notifications to arrive.
src_dir=${NC_SRC_DIR:-$state_home/omarchy/notifications}
src_history=${NC_SRC_HISTORY:-$src_dir/history}
history_json="$src_dir/history.json"

# Ours.
store=${NC_STORE:-$state_home/omarchy-notification-center}
archive="$store/archive.jsonl"
images="$store/images"
seen_file="$store/seen"
lock_file="$store/lock"
dismissed_file="$store/dismissed"
cleared_at_file="$store/cleared_at"

# How much is kept. Both are ceilings and the tighter one wins: 30 days of a
# quiet week is a shorter list than 1000 notifications, and 1000 notifications
# of a loud day is a shorter list than 30 days.
keep_days=${NC_KEEP_DAYS:-30}
max_items=${NC_MAX_ITEMS:-1000}
# Whether to keep a copy of the picture a notification points at. Off is the
# setting for anyone who would rather the archive held words only, and it means
# no copy is made rather than a copy that goes unshown.
previews=${NC_PREVIEWS:-1}

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is not installed"

# One writer at a time, for as long as one command takes. The bar widget runs
# once per monitor, so on a two-screen desktop there are two of these racing to
# append the same notification, and an interleaved append writes half a line.
#
# The lock is taken in a subshell rather than on this shell, because `watch`
# lives for the whole session: a descriptor held open there would lock every
# other invocation out for the rest of the day.
with_lock() {
  ( exec 9>"$lock_file"; flock 9; "$@" )
}

ensure_store() {
  mkdir -p "$store" "$images" || die "cannot create $store"
  [[ -f $archive ]] || : > "$archive"
  [[ -f $dismissed_file ]] || : > "$dismissed_file"
  # Installs that predate the umask above created these 755 and 644, which on a
  # machine with a second account hands over every notification you have had
  # for the reading. Cheap enough to reassert on every call.
  chmod 700 "$store" "$images" 2>/dev/null || true
  chmod 600 "$archive" "$dismissed_file" "$seen_file" "$cleared_at_file" 2>/dev/null || true
}

now_ms() { printf '%s' "$(($(date +%s%N) / 1000000))"; }

# ---------------------------------------------------------------- ingesting

is_dismissed() {
  local key=$1
  [[ -n $key ]] || return 1
  if [[ -s $dismissed_file ]] && grep -qxF -- "$key" "$dismissed_file" 2>/dev/null; then
    return 0
  fi
  if [[ -s $cleared_at_file ]]; then
    local cleared_at stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      stamp=${key%%-*}
      if [[ $stamp =~ ^[0-9]+$ ]] && (( stamp <= cleared_at )); then
        return 0
      fi
    fi
  fi
  return 1
}

# Keys come from the per-file name ("1787227796695-32") on older builds,
# or the row's own key in history.json. Both stay stable when read again,
# making duplicate ingestion harmless. A per-file popup is seen once while
# on screen and again when it moves into history/.
have_key() {
  grep -qF "\"key\":\"$1\"" "$archive" 2>/dev/null
}

# An icon path worth copying: something on disk rather than a themed icon name
# ("slack", "org.mozilla.firefox"), which resolves through the icon theme at
# render time and needs nothing kept for it.
is_path() {
  case $1 in
    file:///*|/*) return 0 ;;
    *) return 1 ;;
  esac
}

# Copy one of the service's images into our own store, and answer with the path
# to the copy. The originals live and die with the ten files the service keeps,
# so an entry that still pointed at one would lose its face within the hour.
copy_image() {
  local src=$1 key=$2 slot=$3 dest
  src=${src#file://}
  [[ -f $src ]] || { printf '%s' ""; return; }
  dest="$images/$key-$slot"
  # Bounded, because these are files another program wrote and a panel has to
  # survive one of them being enormous.
  if timeout 5 head -c 5242881 -- "$src" > "$dest.tmp" 2>/dev/null &&
     (( $(stat -c%s -- "$dest.tmp" 2>/dev/null || echo 0) <= 5242880 )); then
    # Only actual images are kept. These paths arrive on the notification,
    # which is to say from whoever sent it, and an icon "at" ~/.ssh/id_rsa
    # should not quietly become a second copy of it in here.
    if command -v file >/dev/null 2>&1; then
      case "$(file -bL --mime-type -- "$dest.tmp" 2>/dev/null)" in
        image/*) ;;
        *) rm -f -- "$dest.tmp"; printf '%s' ""; return ;;
      esac
    fi
    # A preview is kept at the size it is shown at rather than the size the
    # camera took it at. A month of motion alerts at 175kB each is a store
    # nobody asked for; at panel width they are a fifth of that, and the
    # original is still where it always was.
    if [[ $slot == preview ]] && command -v magick >/dev/null 2>&1; then
      magick "$dest.tmp" -auto-orient -resize '720x720>' -quality 82 "$dest.resized" 2>/dev/null \
        && mv -f -- "$dest.resized" "$dest.tmp"
      rm -f -- "$dest.resized"
    fi
    mv -f -- "$dest.tmp" "$dest"
    printf 'file://%s' "$dest"
  else
    rm -f -- "$dest.tmp"
    printf '%s' ""
  fi
}

# The picture a notification is about, as opposed to the icon of whatever sent
# it. Apps that photograph something (a camera catching movement, a screenshot
# tool) tend not to set an image hint at all: they hand the file to the action
# instead, so clicking the toast opens it. That path is the only place the
# picture is named, so this is where a motion alert gets its thumbnail.
#
# This is also the allowlist for what a click on an archived notification is
# allowed to open, and the reason it is this narrow. The action a notification
# arrives with is chosen by whoever sent the notification, and anything on the
# machine can send one. Keeping that action and running it later is handing an
# attacker a command that fires whenever somebody clicks a row, so it is never
# kept. What is kept is at most an absolute path to an image, taken out of the
# action and opened by argument rather than by shell, and the web address below.
#
# Two shapes arrive here. Omarchy now sends the action as `omarchy-exec-argv`,
# a JSON vector whose elements are already discrete arguments, so a candidate
# is one whole element and a space in a filename is just a space. Older toasts,
# and anything still in the archive from before, carry `omarchy-exec`: one
# shell string, where a space is a separator and a path containing one cannot
# be told apart from two arguments. That is why the string branch refuses
# spaces and the vector branch does not.
#
# Either way: absolute, no quotes, no newlines, and an image extension. A path
# that survives this cannot become an option, a second command, or a .desktop
# file that runs on open.
preview_source() {
  local action=$1

  if [[ $action == \[* ]]; then
    printf '%s' "$action" | jq -r --arg re '^(file://)?/[^"'"'"'\r\n]*\.(jpe?g|png|webp|gif)$' '
      if type == "array" then
        .[] | select(type == "string") | select(test($re; "i"))
      else empty end
    ' 2>/dev/null | head -n 1
    return
  fi

  printf '%s' "$action" | grep -oiE "(file://)?/[^\"' ]*\.(jpe?g|png|webp|gif)" | head -n 1
}

# The web page the action would have opened, if it opened one. Same rule as the
# picture: the command is discarded and only the address is kept, as data. It
# has to be http(s), so a click can bring a page up in the browser but never
# hand a file:// or some other scheme to whatever handles it, and it carries no
# whitespace, quotes or control characters.
link_source() {
  local action=$1

  if [[ $action == \[* ]]; then
    printf '%s' "$action" | jq -r --arg re '^https?://[^\s\x00-\x1f\x7f"'"'"'<>]+$' '
      if type == "array" then
        .[] | select(type == "string") | select(test($re; "i"))
      else empty end
    ' 2>/dev/null | head -n 1
    return
  fi

  printf '%s' "$action" | grep -oiE "https?://[^[:space:][:cntrl:]\"'<>]+" | head -n 1
}

is_service_file() {
  case $1 in
    history.json|live.json|quiet.json) return 0 ;;
    *) return 1 ;;
  esac
}

# Take one per-notification file into the archive. Aggregate files belong to
# the service and must never be mistaken for notifications.
ingest_file() {
  local file=$1 key json
  key=$(basename -- "$file")
  is_service_file "$key" && return 0
  key=${key%.json}
  [[ -n $key && -s $file ]] || return 0
  # A partial write will be caught again on the move or the next sync.
  json=$(jq -ce . "$file" 2>/dev/null) || return 0
  archive_entry "$key" "$json" "${2:-0}"
}

# Shared field mapping and action sanitization. Per-file watch events pass 1
# to announce an existing row too, preserving the older notification stream
# when a popup moves into history/. The service now runs one watcher per shell.
# Catch-up sync and aggregate history pass 0: replaying existing aggregate rows
# on every rewrite would reorder the panel.
archive_entry() {
  local key=$1 json=$2 announce_existing=${3:-0}
  local entry app_icon image_src exec_src icon_copy image_copy file_src link_src preview_copy
  if is_dismissed "$key"; then
    return 0
  fi
  if have_key "$key"; then
    (( announce_existing )) && grep -F "\"key\":\"$key\"" "$archive" | head -n 1
    return 0
  fi
  if [[ -s $cleared_at_file ]]; then
    local cleared_at file_stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      file_stamp=$(jq -r '(.timestamp // 0) | tonumber?' <<< "$json" 2>/dev/null || echo 0)
      if [[ $file_stamp =~ ^[0-9]+$ ]] && (( file_stamp > 0 && file_stamp <= cleared_at )); then
        return 0
      fi
    fi
  fi

  app_icon=$(jq -r '.appIcon // ""' <<< "$json")
  image_src=$(jq -r '.image // ""' <<< "$json")
  # execArgv is what the service writes now; exec is what it wrote before.
  exec_src=$(jq -r '.execArgv // .exec // ""' <<< "$json")

  icon_copy=$app_icon
  image_copy=$image_src
  is_path "$app_icon" && icon_copy=$(copy_image "$app_icon" "$key" "appIcon")
  is_path "$image_src" && image_copy=$(copy_image "$image_src" "$key" "image")

  # The path the action pointed at, if it pointed at an image. This is what a
  # click opens; the command it came out of is discarded here and never
  # reaches the archive.
  file_src=$(preview_source "$exec_src")
  file_src=${file_src#file://}
  link_src=$(link_source "$exec_src")

  preview_copy=""
  if (( previews )) && [[ -n $file_src ]]; then
    preview_copy=$(copy_image "$file_src" "$key" "preview")
  fi

  entry=$(jq -c \
    --arg key "$key" \
    --arg appIcon "$icon_copy" \
    --arg image "$image_copy" \
    --arg preview "$preview_copy" \
    --arg file "$file_src" \
    --arg link "$link_src" \
    '{
       key: $key,
       app: (.app // ""),
       appIcon: $appIcon,
       summary: (.summary // ""),
       body: (.body // ""),
       image: $image,
       preview: $preview,
       file: $file,
       link: $link,
       glyph: (.glyph // ""),
       urgency: (.urgency // 1),
       timestamp: (.timestamp // 0)
     }
     | .timestamp = (if .timestamp > 0 then .timestamp
                     else ((.key | split("-")[0] | tonumber?) // 0) end)' \
    <<< "$json" 2>/dev/null) || return 0
  [[ -n $entry ]] || return 0

  printf '%s\n' "$entry" >> "$archive"
  printf '%s\n' "$entry"
}

# Aggregate history holds seconds, including fractions; the archive holds integer
# milliseconds. Read oldest first so the newest rows stay at the archive's tail.
ingest_history() {
  [[ -s $history_json ]] || return 0
  local key json
  while IFS=$'\t' read -r key json; do
    [[ -n $key ]] || continue
    archive_entry "$key" "$json" 0
  done < <(jq -r '
    if type == "array" then
      map(select(type == "object")
        | select(.key | type == "string")
        | select(.key | test("^[A-Za-z0-9_-]{1,120}$"))
        | .timestamp = ((if (.ts | type) == "number" and .ts > 0 then .ts
                         elif (.closed_ts | type) == "number" and .closed_ts > 0 then .closed_ts
                         else empty end) * 1000 | floor))
      | sort_by(.timestamp) | .[]
      | .key + "\t" + ({app, appIcon, summary, body, glyph, urgency, execArgv, timestamp} | tojson)
    else empty end
  ' "$history_json" 2>/dev/null)
}

# Older builds keep separate files; newer ones rewrite history.json as rows
# close. Both feed the same archive and keep the service's stable keys.
sync_all() {
  local file
  for file in "$src_history"/*.json; do
    [[ -e $file ]] || continue
    ingest_file "$file"
  done
  ingest_history
  for file in "$src_dir"/*.json; do
    [[ -e $file ]] || continue
    ingest_file "$file"
  done
}

# ---------------------------------------------------------------- trimming

# Drop what is past either ceiling, and take the images of dropped entries with
# them. Runs after an ingest rather than on a timer: the only thing that can
# push the archive over a limit is something being added to it.
prune() {
  local cutoff kept dropped
  cutoff=$(( $(now_ms) - keep_days * 86400000 ))

  if [[ -s $cleared_at_file ]]; then
    local cleared_at
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at < cutoff )); then
      rm -f -- "$cleared_at_file"
    fi
  fi

  if [[ -s $dismissed_file ]]; then
    tail -n 2000 "$dismissed_file" > "$dismissed_file.tmp" 2>/dev/null && mv -f "$dismissed_file.tmp" "$dismissed_file"
  fi

  [[ -s $archive ]] || return 0

  # Read first, and only then decide to write. A single unparseable line makes
  # jq exit non-zero having printed nothing, and this used to run that nothing
  # straight back over the archive: one bad byte and somebody's month of
  # notifications was gone. The pipeline hid it twice over, because the status
  # of `jq | tail` is tail's and tail is always happy, and because the `||` on
  # the write emptied the file on the other branch as well. So no pipeline
  # here, and a failed read leaves the archive exactly as it was.
  #
  # An empty result from a jq that *succeeded* is a real answer: everything in
  # there has aged out, and the archive is meant to end up empty.
  # `fromjson?` rather than a plain read: one unparseable line is skipped and
  # the rest of the file still gets through. A plain `jq` stops dead at that
  # line, which meant everything after it was missing from `kept` and was then
  # written back over the archive as the new truth. Everything below the bad
  # byte, gone.
  # A toast can close after a newer one was archived. Restore arrival order
  # before trimming so a late-closing older row cannot evict the newer one.
  if ! kept=$(jq -Rcn --argjson cutoff "$cutoff" \
      '[inputs | fromjson? // empty | select(.timestamp >= $cutoff)]
       | sort_by(.timestamp) | .[]' "$archive" 2>/dev/null); then
    return 0
  fi
  kept=$(printf '%s\n' "$kept" | tail -n "$max_items")

  dropped=$(comm -23 \
    <(jq -r '.key' "$archive" 2>/dev/null | sort) \
    <(printf '%s\n' "$kept" | jq -r 'select(.key) | .key' 2>/dev/null | sort))

  printf '%s\n' "$kept" | grep -v '^$' > "$archive.tmp" || true
  mv -f "$archive.tmp" "$archive"

  # Aggregate rows cannot be removed from the service's read-only history.
  # Remember dropped keys just like dismissals so a rewrite cannot resurrect
  # them and evict newer entries on the next retention pass.
  local key history_keys
  history_keys=$(jq -r 'if type == "array" then .[] | objects | .key | strings
                        else empty end' "$history_json" 2>/dev/null) || history_keys=""
  while IFS= read -r key; do
    [[ -n $key ]] || continue
    if grep -qxF -- "$key" <<< "$history_keys"; then
      printf '%s\n' "$key" >> "$dismissed_file"
    fi
    rm -f -- "$images/$key-appIcon" "$images/$key-image" "$images/$key-preview"
    # The source file too. It was the service's copy of something this archive
    # now no longer has, so there is nothing left that would show it again.
    rm -f -- "$src_history/$key.json"
  done <<< "$dropped"

  # And the source files under the clear line. Clear draws that line instead of
  # deleting anything, which leaves the tidying to happen here: the archive has
  # these, nothing is going to show them again, and this directory is not
  # cleaned by anybody else. Doing it on the retention pass rather than on the
  # click is the whole point, because a click that deletes is a click you have
  # to be sure about.
  if [[ -s $cleared_at_file ]]; then
    local cleared_at f base stamp
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    if [[ $cleared_at =~ ^[0-9]+$ ]] && (( cleared_at > 0 )); then
      for f in "$src_history"/*.json; do
        [[ -e $f ]] || continue
        base=${f##*/}
        base=${base%.json}
        stamp=${base%%-*}
        [[ $stamp =~ ^[0-9]+$ ]] || continue
        (( stamp <= cleared_at )) && rm -f -- "$f"
      done
    fi
  fi
}

# ---------------------------------------------------------------- commands

# `sync` on the command line reports one line, like everything else here; the
# entries it took in are only interesting to `watch`, which streams them to the
# panel. quiet=1 is what keeps a plain sync from printing a page of JSON.
quiet=0

sync_and_prune() {
  if (( quiet )); then
    sync_all >/dev/null
  else
    sync_all
  fi
  prune
}

cmd_sync() {
  ensure_store
  with_lock disarm_archive
  with_lock sync_and_prune
}

# An archive written before stored actions were removed still holds them. That
# is a command an attacker picked, sitting in a file, waiting for a click, so
# it is not something to leave until somebody thinks to run a migration: every
# sync clears it, and once cleared the grep costs nothing.
disarm_archive() {
  grep -q '"exec":' "$archive" 2>/dev/null || return 0
  backfill_previews >/dev/null
}

cmd_watch() {
  ensure_store
  mkdir -p "$src_dir" "$src_history"
  # Catch up first: the shell has been down, or this is the first run, and
  # whatever arrived in the meantime is still lying in those directories.
  cmd_sync

  command -v inotifywait >/dev/null 2>&1 || die "inotifywait is not installed"
  # util-linux, and it is already here on anything running systemd, but say so
  # rather than watch fail on a missing word later.
  command -v setpriv >/dev/null 2>&1 || die "setpriv is not installed"

  # close_write catches a popup being written; moved_to catches it being
  # archived, and catches atomic rewrites of history.json. The key check keeps
  # repeated events from appending the same notification twice, which is
  # cheaper than trying to predict which event will catch a complete file.
  # Read through a descriptor rather than a pipeline, so the watcher is a child
  # of this script rather than of a pipeline that outlives it.
  # `setpriv --pdeathsig TERM` is what ends it. The kernel has the watcher
  # marked to take a TERM the moment this process is gone, however it goes,
  # and that is the only version of the promise that covers a SIGKILL.
  # Omarchy takes this script's process tree down when it reloads plugins, and
  # a reload landing mid-ingest escalates to SIGKILL, which outranks every trap
  # a shell could have been left holding. The watcher used to survive that:
  # it kept its watch, got adopted by systemd --user, and sat on a pipe nothing
  # would write to again until the next notification arrived and SIGPIPEd it
  # down. Ten days of reloads collected 163 of them, holding 350MB between
  # them, so nothing here tracks pids to clean up with. One mechanism in the
  # kernel, and no recorded pid that can outlive the process it was recorded
  # for and aim a kill at whatever later inherited the number.
  exec 3< <(setpriv --pdeathsig TERM inotifywait -m -q -e close_write \
    -e moved_to --format '%w%f' "$src_dir" "$src_history" 2>/dev/null)

  while IFS= read -r file <&3; do
    [[ $file == *.json ]] || continue
    case ${file##*/} in
      history.json) with_lock ingest_history_one ;;
      live.json|quiet.json) continue ;;
      *) with_lock ingest_one "$file" ;;
    esac
  done
}

ingest_history_one() {
  ingest_history
  prune
}

ingest_one() {
  ingest_file "$1" 1
  prune
}

cmd_list() {
  ensure_store
  local limit=${1:-200}
  local cleared_at=0
  if [[ -s $cleared_at_file ]]; then
    cleared_at=$(cat "$cleared_at_file" 2>/dev/null || echo 0)
    [[ $cleared_at =~ ^[0-9]+$ ]] || cleared_at=0
  fi

  # Newest first, because that is the order it is read in. Cleared entries are
  # filtered rather than deleted, so the cut has to happen before the limit:
  # take the newest N of what is still showing, not what is left of the newest
  # N after the cleared ones are dropped out of it.
  tac "$archive" 2>/dev/null \
    | jq -Rc --argjson cleared "$cleared_at" \
        'fromjson? // empty | select((.timestamp // 0) > $cleared)' 2>/dev/null \
    | head -n "$limit" \
    | jq -s '.' 2>/dev/null || printf '[]\n'
}

remove_key() {
  local key=$1
  [[ -n $key ]] || return 0
  printf '%s\n' "$key" >> "$dismissed_file"
  grep -vF "\"key\":\"$key\"" "$archive" > "$archive.tmp" 2>/dev/null || : > "$archive.tmp"
  mv -f "$archive.tmp" "$archive"
  rm -f -- "$images/$key-appIcon" "$images/$key-image" "$images/$key-preview"
  # Both directories, not only history: a notification dismissed while its
  # toast is still on screen is sitting in the popup directory, and leaving it
  # there means the move into history archives it again a moment later.
  # These names are aggregate state, even when a caller supplies one as a key.
  if ! is_service_file "$key.json"; then
    rm -f -- "$src_history/$key.json" "$src_dir/$key.json"
  fi
}

cmd_remove() {
  ensure_store
  local key=$1
  [[ -n $key ]] || die "remove needs a key"
  with_lock remove_key "$key"
  printf '{"ok":true,"removed":%s}\n' "$(printf '%s' "$key" | jq -Rs .)"
}

# Clear is a line drawn under what you have seen, not a shredder. It used to
# empty the archive, delete every stored image, and delete the source history
# out from under the service as well, which is a lot of somebody's month to
# hang on one click with no way back.
#
# The timestamp on its own already does the whole job: `is_dismissed` treats
# every key older than it as dismissed, ingest skips source files older than
# it, and `list` filters on it. Everything below the line simply stops being
# shown, and ages out through the ordinary retention limits like everything
# else. Nothing to confirm, because nothing is destroyed.
clear_all() {
  now_ms > "$cleared_at_file"
}

cmd_clear() {
  ensure_store
  with_lock clear_all
  printf '{"ok":true,"cleared":true}\n'
}

# When the center was last opened. Everything newer than this is what the bar
# marks as unread, and it is a file rather than shell state because "unread"
# has to survive a shell restart to mean anything.
cmd_seen() {
  ensure_store
  if [[ $# -gt 0 && -n ${1:-} ]]; then
    printf '%s\n' "$1" > "$seen_file"
    printf '{"ok":true,"seen":%s}\n' "$1"
    return
  fi
  printf '{"ok":true,"seen":%s}\n' "$(cat "$seen_file" 2>/dev/null || echo 0)"
}

cmd_unread() {
  ensure_store
  local seen
  seen=$(cat "$seen_file" 2>/dev/null || echo 0)
  printf '{"ok":true,"unread":%s}\n' \
    "$(jq -s --argjson seen "${seen:-0}" '[.[] | select(.timestamp > $seen)] | length' "$archive" 2>/dev/null || echo 0)"
}

# Fills the archive with plausible-looking traffic, for working on the panel
# without waiting for a week of real notifications to arrive, and for taking a
# screenshot that gives nobody's messages away.
#
# The entries are spread back over three days so the day headings have
# something to head, and they name real apps with real icon names so the icons
# resolve out of the icon theme the way they do for the real thing.
cmd_seed() {
  ensure_store
  rm -f -- "$cleared_at_file"
  : > "$dismissed_file"
  with_lock seed_entries "${1:-25}"
  printf '{"ok":true,"seeded":%s}\n' "${1:-25}"
}

# A picture for the seeded entries that have one. Any wallpaper will do: the
# point is a card with a real photograph on it, so the layout is exercised and
# a screenshot of the panel shows what a motion alert or a screenshot toast
# actually looks like. Falls back to no picture at all when the themes are
# somewhere else.
seed_sample_image() {
  local candidate
  for candidate in \
    "$HOME/.config/omarchy/current/theme/backgrounds"/* \
    "${OMARCHY_PATH:-/usr/share/omarchy}/themes"/*/backgrounds/*; do
    [[ -f $candidate ]] || continue
    case $candidate in
      *.png|*.jpg|*.jpeg|*.webp) printf '%s' "$candidate"; return ;;
    esac
  done
  printf '%s' ""
}

# app | icon name | summary | body | how many minutes ago | picture (1/0)
readonly SEED_ROWS=(
  "omasnap||Screenshot saved and copied|Click to edit|2|1"
  "Camera||Motion at the back door|17:41|9|1"
  "Slack|slack|#design from Mara|Pushed the new empty state, have a look when you get a minute|4"
  "Uptime Kuma||api is up|{\"monitor\":\"api\",\"status\":\"up\",\"ping_ms\":42,\"region\":\"fsn1\",\"attempt\":1,\"url\":\"https://api.nova.dev/health\"}|7"
  "Spotify|spotify|Talk Talk|Life's What You Make It|12"
  "Chromium|chromium|Calendar|Standup starts in 10 minutes|38"
  "Signal|signal-desktop|Jules|Are we still on for Thursday?|55"
  "omarchy||Reminder|Stand up and walk about|96"
  "Slack|slack|#ops from Ilse|Deploy 4f21c9 is live on production|140"
  "Thunderbird|thunderbird|Invoice paid|Nova Systems paid invoice 2026-114|190"
  "Discord|discord|#homelab from bram|that fan curve fixed it, 12 degrees cooler|260"
  "Chromium|chromium|GitHub|arturo approved your pull request|320"
  "Slack|slack|#design from Mara|and the dark variant too|388"
  "Spotify|spotify|Blockhead|The Music Scene|455"
  "omarchy||Update available|17 packages, including linux 6.14.3|520"
  "Signal|signal-desktop|Mum|Landed, all fine|1180"
  "Slack|slack|#general from Wieke|Lunch is in the kitchen|1290"
  "Chromium|chromium|Calendar|Retro moved to 15:00|1420"
  "Thunderbird|thunderbird|Domain renewal|jankeesvw.com renews in 14 days|1580"
  "Discord|discord|#homelab from bram|new NAS drives arrived|1750"
  "Slack|slack|#ops from Ilse|Backups green again after the disk swap|1900"
  "Spotify|spotify|Nils Frahm|Says|2100"
  "omarchy||Theme changed|Tokyo Night|2400"
  "Signal|signal-desktop|Jules|Thursday works, 19:00?|2900"
  "Chromium|chromium|GitHub|CI passed on notification-center|3300"
  "Slack|slack|#design from Mara|shipping it|3800"
  "Thunderbird|thunderbird|Receipt|Hetzner, EUR 14,28|4200"
)

seed_entries() {
  local count=${1:-25} i row stamp key
  local app icon summary body minutes wants_picture preview sample
  local total=${#SEED_ROWS[@]}
  sample=$(seed_sample_image)
  for (( i = 0; i < count; i++ )); do
    row=${SEED_ROWS[$((i % total))]}
    IFS='|' read -r app icon summary body minutes wants_picture <<< "$row"
    # Past one lap through the list the same entries come round again, pushed
    # another two days back so they land on their own day rather than on top of
    # the ones they are copies of.
    stamp=$(( $(now_ms) - (minutes + (i / total) * 2880) * 60000 ))
    key="seed-$stamp-$i"
    preview=""
    [[ ${wants_picture:-0} == 1 && -n $sample ]] && preview=$(copy_image "$sample" "$key" "preview")
    jq -cn \
      --arg key "$key" \
      --arg app "$app" \
      --arg appIcon "$icon" \
      --arg summary "$summary" \
      --arg body "$body" \
      --arg preview "$preview" \
      --argjson timestamp "$stamp" \
      '{key:$key, app:$app, appIcon:$appIcon, summary:$summary, body:$body,
        image:"", preview:$preview, file:"", glyph:"", urgency:1,
        timestamp:$timestamp}' >> "$archive"
  done
  # Seeded entries land out of order; the archive is read newest-first off the
  # tail, so it has to be sorted or half of them never show up.
  jq -sc 'sort_by(.timestamp) | .[]' "$archive" > "$archive.tmp" && mv -f "$archive.tmp" "$archive"
}

# Two jobs over the existing archive, both idempotent, both safe to run twice.
#
# The first is the important one: an archive written by an older version still
# holds `exec`, the sender-chosen shell command the notification arrived with.
# Those are stripped, and the image path is lifted out of them first, so
# nothing is lost except the ability to run a stranger's command.
#
# The second is the ordinary one: entries that never had a picture get one now
# if the file they name is still on disk.
backfill_previews() {
  local tmp="$archive.backfill" line key exec_src file_src preview_copy filled=0
  : > "$tmp"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    key=$(printf '%s' "$line" | jq -r '.key // ""')
    [[ -n $key ]] || { printf '%s\n' "$line" >> "$tmp"; continue; }

    file_src=$(printf '%s' "$line" | jq -r '.file // ""')
    if [[ -z $file_src ]]; then
      exec_src=$(printf '%s' "$line" | jq -r '.exec // ""')
      file_src=$(preview_source "$exec_src")
      file_src=${file_src#file://}
    fi

    preview_copy=$(printf '%s' "$line" | jq -r '.preview // ""')
    if [[ -z $preview_copy && -n $file_src ]] && (( previews )); then
      preview_copy=$(copy_image "$file_src" "$key" "preview")
      [[ -n $preview_copy ]] && filled=$(( filled + 1 ))
    fi

    printf '%s' "$line" | jq -c \
      --arg file "$file_src" \
      --arg preview "$preview_copy" \
      'del(.exec) + {file: $file, preview: $preview}' >> "$tmp"
  done < "$archive"
  mv -f "$tmp" "$archive"
  printf '%s' "$filled"
}

case ${1:-} in
  sync)   shift; quiet=1; cmd_sync; printf '{"ok":true,"synced":true}\n' ;;
  watch)  shift; cmd_watch ;;
  list)   shift; cmd_list "${1:-200}" ;;
  remove) shift; cmd_remove "${1:-}" ;;
  clear)  shift; cmd_clear ;;
  seen)   shift; cmd_seen "$@" ;;
  unread) shift; cmd_unread ;;
  seed)   shift; cmd_seed "${1:-25}" ;;
  backfill)
    shift; ensure_store
    printf '{"ok":true,"filled":%s}\n' "$(with_lock backfill_previews)"
    ;;
  prune)  shift; ensure_store; with_lock prune; printf '{"ok":true,"pruned":true}\n' ;;
  *)
    cat >&2 <<'USAGE'
notification-center: the store behind the Omarchy notification center

  watch              follow the notification service and archive what it receives
  sync               catch up on anything not archived yet
  list [LIMIT]       the archive as JSON, newest first (default 200)
  remove KEY         drop one notification
  clear              drop all of them
  seen [MS]          read or set when the center was last opened
  unread             how many arrived since then
  seed [N]           fill the archive with test traffic
  backfill           give older entries the picture their action points at
  prune              apply the retention limits now
USAGE
    exit 64
    ;;
esac
